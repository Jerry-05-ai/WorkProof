# ============================================================
# WorkProof — environment variables reference
# Copy relevant values into Vercel Project Settings → Environment
# Variables. Never commit a real .env file (it's already gitignored).
# ============================================================

# --- Server ---
NODE_ENV=production
PORT=8000

# --- Database (MySQL) — REQUIRED. This is the app's actual data store; ---
# --- nothing works (including demo login) until this is a real, reachable ---
# --- MySQL instance with database/schema.sql applied. ---
DB_HOST=
DB_PORT=3306
DB_NAME=workproof
DB_USER=
DB_PASS=
DB_POOL_LIMIT=10

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_COOKIE_NAME=wp_session
# Only set to "true" if the frontend and API are on genuinely different domains.
CROSS_SITE_COOKIES=false
# Optional. Leave unset unless you need the cookie scoped to a specific domain.
COOKIE_DOMAIN=

# --- CORS / frontend origin ---
FRONTEND_ORIGIN=https://work-proof.vercel.app

# --- Firebase (optional — NOT the database; see server/server.js comments) ---
FIREBASE_SERVICE_ACCOUNT_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
