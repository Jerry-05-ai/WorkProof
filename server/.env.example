# ============================================================
# WorkProof Express Backend — environment variables
# Copy to `.env` and fill in. Never commit `.env`.
# ============================================================

# --- Server ---
PORT=8000
NODE_ENV=development

# --- Firebase Data Connect ---
# Full service account JSON as a single-line string (escaped quotes).
# Example: FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
FIREBASE_SERVICE_ACCOUNT_KEY=replace-with-service-account-json
FIREBASE_PROJECT_ID=workproof-8634e

# --- Auth (JWT stored in an httpOnly cookie) ---
# Generate a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=wp_session

# Set to "true" ONLY in production when the frontend is on a DIFFERENT domain
# than the API (cross-site cookies). Requires HTTPS on both.
CROSS_SITE_COOKIES=false

# --- CORS / frontend origin(s), comma-separated ---
# The React dev/prod origin allowed for CORS + where invite links point.
FRONTEND_ORIGIN=http://localhost:5173